# ============================================================
# Configuration unique du livestream autonome.
# Remplissez ce fichier UNE SEULE FOIS, puis lancez :
#   node bootstrap.js
# Tout le reste (VPS, déploiement, planification, automatisation
# YouTube) est fait automatiquement à partir d'ici.
# Ne partagez jamais ce fichier une fois rempli (il contient des
# secrets) et ne le collez jamais dans un chat.
# ============================================================

oci:
  compartment_ocid: "ocid1.tenancy.oc1..VOTRE_TENANCY_OCID"   # compartiment racine = OCID du tenancy
  region: "eu-turin-1"
  user_ocid: "ocid1.user.oc1..VOTRE_USER_OCID"
  fingerprint: "xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx"
  # Chemin vers votre clé privée API OCI sur VOTRE machine locale.
  # Ne collez jamais le contenu de la clé ici — seulement son chemin.
  key_file: "~/.oci/oci_api_key.pem"
  instance_ocpus: 2
  instance_memory_gb: 12

ssh:
  public_key_path: "~/.ssh/id_ed25519.pub"
  private_key_path: "~/.ssh/id_ed25519"
  # Votre IP publique en /32 (voir whatismyip.com) — jamais 0.0.0.0/0
  allowed_cidr: "VOTRE.IP.PUBLIQUE/32"

youtube:
  stream_key: "votre-cle-de-stream-youtube"
  # Optionnel — laissez vide si vous ne connaissez pas encore l'ID du
  # flux persistant (nécessaire uniquement pour google.enabled: true)
  stream_id: ""

# Automatisation du titre daté + description quotidiens.
# Si activé et que client_id/client_secret sont renseignés mais que
# refresh_token est vide, bootstrap.js ouvrira une autorisation Google
# dans votre navigateur UNE SEULE FOIS puis remplira refresh_token
# automatiquement dans ce fichier pour tous les lancements suivants.
google:
  enabled: false
  client_id: ""
  client_secret: ""
  refresh_token: ""
